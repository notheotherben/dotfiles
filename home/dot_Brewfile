# Homebrew Bundle manifest — deployed by chezmoi to ~/.Brewfile
#
#   Apply with:  brew bundle --global
#   Edit via:    chezmoi edit ~/.Brewfile   (source: home/dot_Brewfile)
#
# Language runtimes (node, go, deno) are
# managed by mise instead — see ~/.config/mise/config.toml.

tap "hashicorp/tap"
tap "sierrasoftworks/tap"

brew "mise"                    # language runtimes
brew "chezmoi"                 # this dotfiles manager

cask "1password"
cask "1password-cli@beta"
cask "android-platform-tools"  # adb / fastboot (was `android-tools`)
cask "claude-code"
cask "fastmail"
cask "firefox"
cask "little-snitch"
cask "orbstack"                # Docker / Linux runtime (replaces the docker CLI)
cask "signal"
cask "spotify"
cask "synology-drive"
cask "tailscale-app"           # Tailscale GUI + CLI
cask "telegram"
cask "todoist-app"
cask "whatsapp"
cask "zed"

brew "ansible"
brew "atuin"                   # shell history sync
brew "azure-cli"
brew "caddy"
brew "cargo-binstall"
brew "dotnet@10"                # mise's dotnet support is a community plugin; brew is more reliable
brew "fish"                    # primary login shell
brew "git"
brew "grpcurl"
brew "jq"
brew "powershell"
brew "protobuf"                # `protoc`
brew "rustic"                  # backup tool (driven by the rustic-backup LaunchAgent)
brew "rustup"
brew "shellcheck"
brew "speedtest-cli"
brew "starship"                # prompt
brew "uv"
brew "vim"
brew "xh"                      # aliased to `http`
brew "zsh-syntax-highlighting" # zsh fallback niceties

brew "hashicorp/tap/vault"
brew "hashicorp/tap/terraform"

brew "sierrasoftworks/tap/git-tool"
brew "sierrasoftworks/tap/shig"
brew "sierrasoftworks/tap/tailservice"
