#!/bin/sh
# OpenTelemetry on the desktop: a native otelcol-contrib service shipping
# journald logs and host metrics to telemetry.sierrasoftworks.com, plus the
# eBPF profiler for whole-host continuous profiling (the same collector
# distribution infra-ansible's otel_ebpf_profiler role runs on the cluster
# nodes — but from the release binary, not a privileged docker container:
# the otelcol-ebpf-profiler tarball ships in the same release train as
# otelcol-contrib, and running it natively drops the docker-at-boot
# dependency a desktop otherwise wouldn't have).
#
# Both binaries are pinned GitHub release downloads: the AUR otelcol-contrib
# package has been flagged out-of-date for months, and nothing packages the
# profiler at all.
#
# Configs are chezmoi-managed under ~/.config/otelcol but *installed* to /etc,
# because $HOME is systemd-homed LUKS: locked at boot, which is exactly when
# these system services start.
{{ if eq .chezmoi.os "linux" -}}
#
# Re-run when either config changes:
# otelcol config hash:  {{ include "dot_config/otelcol/otelcol.yaml" | sha256sum }}
# profiler config hash: {{ include "dot_config/otelcol/profiler.yaml" | sha256sum }}
set -eu

# Both halves of the same collector release train; bump together, and keep
# roughly current with the cluster's otelcol pack.
otelcol_version="0.159.0"

# install(1) refuses a pipe as its source, so stage stdin in a temp file first.
install_stdin() {
  dest="$1"
  tmp="$(mktemp)"
  cat >"$tmp"
  sudo install -m 0644 -o root -g root "$tmp" "$dest"
  rm -f "$tmp"
}

# Install one distribution binary from the pinned release, checksum-verified.
# Usage: install_dist <name>  (e.g. otelcol-contrib, otelcol-ebpf-profiler)
install_dist() {
  name="$1"
  bin="/usr/local/bin/$name"
  have="$("$bin" --version 2>/dev/null | awk '{print $NF}' || true)"
  [ "$have" = "$otelcol_version" ] && return 0

  echo "==> Installing $name $otelcol_version (have: ${have:-none})"
  tmp="$(mktemp -d)"
  base="https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v${otelcol_version}"
  asset="${name}_${otelcol_version}_linux_amd64.tar.gz"
  curl -fsSL -o "$tmp/$asset" "$base/$asset"
  curl -fsSL -o "$tmp/$asset.sha256" "$base/$asset.sha256"
  want_sum="$(awk '{print $1}' "$tmp/$asset.sha256")"
  got_sum="$(sha256sum "$tmp/$asset" | awk '{print $1}')"
  if [ "$want_sum" != "$got_sum" ]; then
    echo "!! Checksum mismatch for $asset (want $want_sum, got $got_sum)"
    rm -rf "$tmp"
    exit 1
  fi
  tar -xzf "$tmp/$asset" -C "$tmp" "$name"
  sudo install -m 0755 -o root -g root "$tmp/$name" "$bin"
  rm -rf "$tmp"
}

install_dist otelcol-contrib
install_dist otelcol-ebpf-profiler

# --------------------------------------------------------------------------
# Collector: validate, install config, unit.
# --------------------------------------------------------------------------
echo "==> Validating the collector config"
/usr/local/bin/otelcol-contrib validate --config "$HOME/.config/otelcol/otelcol.yaml"

echo "==> Installing /etc/otelcol/config.yaml"
sudo install -d -m 0755 /etc/otelcol
sudo install -m 0644 -o root -g root \
  "$HOME/.config/otelcol/otelcol.yaml" /etc/otelcol/config.yaml

echo "==> Installing otelcol.service"
install_stdin /etc/systemd/system/otelcol.service <<EOF
# Managed by chezmoi — see run_onchange_after_49-otelcol.sh.tmpl.
[Unit]
Description=OpenTelemetry Collector (journald logs + host metrics)
Documentation=https://opentelemetry.io/docs/collector/
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/otelcol-contrib --config=/etc/otelcol/config.yaml
Restart=always
RestartSec=10

# Runs as root: the journald receiver reads every unit's journal and the
# hostmetrics process scraper reads other users' /proc entries. Everything
# else is locked down — the only writable path is /var/lib/otelcol.
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=otelcol
PrivateTmp=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
EOF

# --------------------------------------------------------------------------
# eBPF profiler: sysctl override, validate, install config, unit.
# --------------------------------------------------------------------------
echo "==> Installing the kptr_restrict override"
# CachyOS defaults kernel.kptr_restrict=2 (70-cachyos-settings.conf), which
# zeroes /proc/kallsyms for *everyone* — root and CAP_SYSLOG included — and
# the profiler dies at startup with "unable to read kallsyms addresses".
# 1 reveals the addresses to CAP_SYSLOG holders only; unprivileged
# processes still see zeros.
install_stdin /etc/sysctl.d/80-otel-ebpf-profiler.conf <<EOF
# Managed by chezmoi — see run_onchange_after_49-otelcol.sh.tmpl.
# Overrides /usr/lib/sysctl.d/70-cachyos-settings.conf: the eBPF profiler
# needs real kernel symbol addresses from /proc/kallsyms.
kernel.kptr_restrict = 1
EOF
sudo sysctl -q -p /etc/sysctl.d/80-otel-ebpf-profiler.conf

echo "==> Validating the profiler config"
/usr/local/bin/otelcol-ebpf-profiler validate \
  --config "$HOME/.config/otelcol/profiler.yaml" \
  --feature-gates=service.profilesSupport

echo "==> Installing /etc/otel-ebpf-profiler/config.yaml"
sudo install -d -m 0755 /etc/otel-ebpf-profiler
sudo install -m 0644 -o root -g root \
  "$HOME/.config/otelcol/profiler.yaml" /etc/otel-ebpf-profiler/config.yaml

echo "==> Installing otel-ebpf-profiler.service"
install_stdin /etc/systemd/system/otel-ebpf-profiler.service <<EOF
# Managed by chezmoi — see run_onchange_after_49-otelcol.sh.tmpl.
[Unit]
Description=OpenTelemetry eBPF profiler (continuous profiling agent)
Documentation=https://github.com/open-telemetry/opentelemetry-ebpf-profiler
After=network-online.target
Wants=network-online.target

[Service]
# Runs as root: loading the eBPF programs and symbolising every other
# process's stacks needs the full capability set in the initial namespaces.
# The profiles signal is still in development upstream, hence the feature
# gate (matching the cluster's otelcol job).
ExecStart=/usr/local/bin/otelcol-ebpf-profiler \\
  --config=/etc/otel-ebpf-profiler/config.yaml \\
  --feature-gates=service.profilesSupport
Restart=always
RestartSec=10

NoNewPrivileges=true
# read-only rather than yes: stacks are symbolised by reading the executable
# behind each mapping, and plenty of those live under ~ (mise shims, cargo
# builds, …).
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
EOF

# --------------------------------------------------------------------------
# Enable and (re)start both services.
# --------------------------------------------------------------------------
echo "==> Starting otelcol.service and otel-ebpf-profiler.service"
sudo systemctl daemon-reload
sudo systemctl enable otelcol.service otel-ebpf-profiler.service
sudo systemctl restart otelcol.service otel-ebpf-profiler.service

sleep 2
systemctl --no-pager --lines=0 status otelcol.service otel-ebpf-profiler.service || {
  echo "!! One of the services is unhealthy — journalctl -u otelcol -u otel-ebpf-profiler"
  exit 1
}
{{ else -}}
exit 0
{{ end -}}
