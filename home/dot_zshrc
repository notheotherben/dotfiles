# zsh config — deployed by chezmoi to ~/.zshrc
# Fallback shell; fish is the primary login shell. Replaces the old nix
# programs.zsh interactiveShellInit block.

# Completion
autoload -Uz compinit && compinit

# Tool versions, PATH and env vars (VAULT_ADDR, GITTOOL_CONFIG, …)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Shell history sync
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

# git-tool integration
if command -v git-tool >/dev/null 2>&1; then
  eval "$(git-tool shell-init zsh)"
fi

# Syntax highlighting (must be sourced last)
for zsh_hl in \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
do
  if [ -f "$zsh_hl" ]; then
    source "$zsh_hl"
    break
  fi
done
unset zsh_hl

# Aliases
alias gt='git-tool'
alias http='xh'
