#!/bin/sh
# ReGreet (via greetd, inside cage) as the login screen, replacing SDDM.
#
# Two files are managed here:
#   /etc/greetd/config.toml   what greetd launches, and as whom
#   /etc/greetd/regreet.toml  the greeter's own configuration
#
# ReGreet rather than a prettier greeter because of how this account
# authenticates. systemd-homed with a FIDO2 token is a multi-prompt PAM
# conversation — password, then "Security token PIN:", then "Sorry, retry
# security token PIN:" after a bad one — and greetd relays each of those as a
# separate auth_message. ReGreet loops over them, shows the real prompt text,
# and clears the field between prompts, so one typo costs one of the token's
# eight PIN retries. A greeter that answers every auth_message with the one
# string it buffered spends three at once and blocks the token until it is
# physically reinserted.
#
# Runs after 45-pam-u2f so the PAM checks below see the finished stack.
{{ if eq .chezmoi.os "linux" -}}
set -eu

greeter_bin="/usr/bin/regreet"
compositor_bin="/usr/bin/cage"
greeter_user="greeter"
cache_dir="/var/cache/regreet"

for bin in "$greeter_bin" "$compositor_bin"; do
  if [ ! -x "$bin" ]; then
    echo "!! $bin not found — skipping (pacman should install greetd-regreet and cage)"
    exit 0
  fi
done

# install(1) refuses a pipe as its source, so stage stdin in a temp file first.
install_stdin() {
  owner="$1"
  dest="$2"
  tmp="$(mktemp)"
  cat >"$tmp"
  sudo install -m 0644 -o "$owner" -g "$owner" "$tmp" "$dest"
  rm -f "$tmp"
}

# --------------------------------------------------------------------------
# PAM sanity checks.
#
# greetd authenticates through /etc/pam.d/greetd, and this account lives on
# systemd-homed: the password typed at the greeter is what unlocks the LUKS
# home area, so the stack has to reach pam_systemd_home and must *not* let a
# Yubikey short-circuit it. Getting this wrong locks the machine out at boot,
# so refuse to switch display managers rather than fix it up silently.
# --------------------------------------------------------------------------
pam_file="/etc/pam.d/greetd"
pam_ok=1

# Follow `include`/`substack` one level at a time so the checks below see the
# whole chain (greetd -> system-local-login -> system-login -> system-auth).
pam_stack() {
  awk '
    function emit(f,   line, n, parts) {
      if (seen[f]++) return
      while ((getline line < f) > 0) {
        print line
        n = split(line, parts, /[ \t]+/)
        if (n >= 3 && (parts[2] == "include" || parts[2] == "substack")) {
          emit("/etc/pam.d/" parts[3])
        }
      }
      close(f)
    }
    BEGIN { emit(ARGV[1]) }
  ' "$1"
}

if [ ! -f "$pam_file" ]; then
  echo "!! $pam_file is missing — greetd is not installed correctly"
  pam_ok=0
else
  stack="$(pam_stack "$pam_file")"

  # A Yubikey `sufficient` rule here would satisfy PAM without ever handing a
  # password to pam_systemd_home, leaving $HOME locked. 45-pam-u2f never adds
  # one; this catches a hand-edit or a leftover from a pre-homed setup.
  if printf '%s\n' "$stack" | grep -qE '^-?[[:space:]]*auth.*pam_u2f\.so'; then
    echo "!! $pam_file reaches pam_u2f.so in its auth stack."
    echo "!! systemd-homed needs the real password to unlock ~; remove that rule first."
    pam_ok=0
  fi

  # Arch puts pam_systemd_home in system-auth, which greetd inherits via
  # system-local-login. Without it there is nothing to unlock the home area.
  if ! printf '%s\n' "$stack" | grep -qE '^-?[[:space:]]*auth.*pam_systemd_home\.so'; then
    echo "!! $pam_file never reaches pam_systemd_home.so — homed logins would fail."
    pam_ok=0
  fi

  # greetd has to register a logind session for the user, otherwise the
  # Hyprland/UWSM session comes up without a seat.
  if ! grep -qE '^[[:space:]]*session.*pam_(systemd|elogind)\.so' "$pam_file"; then
    echo "==> Adding pam_systemd session rule to $pam_file"
    sudo cp -n "$pam_file" "$pam_file.pregreeter.bak"
    printf 'session    required     pam_systemd.so\n' |
      sudo tee -a "$pam_file" >/dev/null
  fi
fi

# --------------------------------------------------------------------------
# greetd + greeter configuration.
# --------------------------------------------------------------------------
echo "==> Writing /etc/greetd/config.toml"
sudo mkdir -p /etc/greetd
sudo cp -n /etc/greetd/config.toml /etc/greetd/config.toml.pregreeter.bak 2>/dev/null || true
# cage flags: -s keeps VT switching available (the escape hatch if the greeter
# ever wedges), -m last pins it to one output because ReGreet is single-monitor,
# -d drops client-side decorations.
printf '%s\n' \
  '# Managed by chezmoi — see run_onchange_after_47-greetd.sh.tmpl.' \
  '' \
  '[terminal]' \
  'vt = 1' \
  '' \
  '[default_session]' \
  "command = \"$compositor_bin -s -m last -d -- $greeter_bin\"" \
  "user = \"$greeter_user\"" |
  install_stdin root /etc/greetd/config.toml

echo "==> Writing /etc/greetd/regreet.toml"
sudo cp -n /etc/greetd/regreet.toml /etc/greetd/regreet.toml.pregreeter.bak 2>/dev/null || true
printf '%s\n' \
  '# Managed by chezmoi — see run_onchange_after_47-greetd.sh.tmpl.' \
  '' \
  '# Jump straight to the password prompt for the last user instead of the' \
  '# picker. Needs a cached choice under /var/cache/regreet, so the first boot' \
  '# still asks; ReGreet also refuses to auto-login a user PAM never challenges.' \
  'skip_selection = true' \
  '' \
  '[GTK]' \
  'application_prefer_dark_theme = true' \
  'cursor_theme_name = "Adwaita"' \
  'icon_theme_name = "Adwaita"' \
  'theme_name = "Adwaita"' \
  '# Cantarell and Adwaita ship with the GTK stack, so they resolve for the' \
  '# unprivileged greeter user; anything under ~/.local/share is inside the' \
  '# encrypted home this screen exists to unlock.' \
  'font_name = "Cantarell 14"' \
  '' \
  '[commands]' \
  'reboot = [ "systemctl", "reboot" ]' \
  'poweroff = [ "systemctl", "poweroff" ]' \
  '' \
  '[appearance]' \
  '# Worth reading rather than typing past: PAM asks for the account password' \
  '# first and the FIDO2 PIN second, and says so in the prompt above the field.' \
  'greeting_msg = "Password first, then the security token PIN."' |
  install_stdin root /etc/greetd/regreet.toml

# ReGreet remembers the last user and session here; without it every boot
# starts on the user picker.
sudo install -d -m 0755 -o "$greeter_user" -g "$greeter_user" "$cache_dir"

# --------------------------------------------------------------------------
# Display manager switch.
# --------------------------------------------------------------------------
if [ "$pam_ok" -ne 1 ]; then
  echo "!! Leaving the current display manager enabled until the PAM issues above are fixed."
  exit 0
fi

if [ "$(systemctl is-enabled greetd.service 2>/dev/null || true)" = "enabled" ]; then
  echo "==> greetd is already the display manager"
  exit 0
fi

# Order matters: disabling sddm drops its display-manager.service alias, which
# `systemctl enable greetd` then claims. Never --now — that would kill the
# session running this script.
echo "==> Switching the display manager to greetd"
sudo systemctl disable sddm.service 2>/dev/null || true
sudo systemctl enable greetd.service
echo "==> Reboot to land on ReGreet (sddm stays installed as a fallback)"
{{ else -}}
exit 0
{{ end -}}
