# yaml-language-server: $schema=https://schemas.sierrasoftworks.com/git-tool/v2/config.schema.json
$schema: https://schemas.sierrasoftworks.com/git-tool/v2/config.schema.json
directory: "{{env.HOME}}/dev"
scratchpads: "{{env.HOME}}/scratch"
worktrees: "{{env.HOME}}/worktrees"
services:
- name: gh
  website: https://github.com/{{ "{{ .Repo.FullName }}" }}
  gitUrl: https://github.com/{{ "{{ .Repo.FullName }}" }}.git
  pattern: '*/*'
  api:
    kind: GitHub/v3
    url: https://api.github.com
- name: ghp
  website: https://github.com/{{ "{{ .Repo.FullName }}" }}
  gitUrl: https://github.com/{{ "{{ .Repo.FullName }}" }}.git
  pattern: '*/*'
apps:
- name: shell
  command: fish
- name: code
  command: code
  args:
  - .
- name: claude
  command: claude
{{ if eq .chezmoi.os "darwin" -}}
- name: finder
  command: /usr/bin/open
  args:
  - -a
  - Finder
  - '{{ .Target.Path }}'
{{- end }}
aliases: {}
trusted_repos: {}
features:
  always_open_best_match: true
  check_exists: true
  check_for_updates: true
  create_remote: true
  create_remote_private: true
  fork_remote: true
  move_remote: true
  open_new_repo_in_default_app: true
  telemetry: true