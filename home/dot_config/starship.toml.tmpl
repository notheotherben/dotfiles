# Starship prompt — deployed by chezmoi to ~/.config/starship.toml

palette = "monokai-pro-spectrum"
format = "\n[](fg:bright-red)[$directory](bg:bright-red)[](fg:bright-red bg:bright-yellow)$git_branch[](fg:bright-yellow bg:yellow)$git_status[](fg:yellow bg:bright-black)$time[](fg:bright-black bg:none) $all$character "

add_newline = true

[directory]
style = "bg:bright-red fg:background"

[git_branch]
format = "[ $symbol$branch ]($style)"
style = "bg:bright-yellow fg:background"

[git_status]
format = "[ $all_status$ahead_behind ]($style)"
style = "bg:yellow fg:background"

[time]
disabled = false
format = "[ $time ]($style)"
style = "bg:bright-black fg:foreground"

[palettes.monokai-pro-spectrum]
# ANSI colors
black          = "#2d2a2e"
red            = "#ff5c57"
green          = "#a9dc76"
yellow         = "#ffd866"
blue           = "#3399cc"
magenta        = "#ff6188"
cyan           = "#78dce8"
white          = "#fcfcfa"
bright-black   = "#727072"
bright-red     = "#ff5c57"
bright-green   = "#a9dc76"
bright-yellow  = "#ffd866"
bright-blue    = "#3399cc"
bright-magenta = "#ff6188"
bright-cyan    = "#78dce8"
bright-white   = "#fcfcfa"

# Terminal colors
background           = "#2d2a2e"
foreground           = "#fcfcfa"
cursor               = "#fcfcfa"
selection-background = "#ffd866"
selection-foreground = "#19181a"


