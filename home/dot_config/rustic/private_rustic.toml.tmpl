{{- with $root := . }}
{{- with $details := onepasswordDetailsFields "z54pr2l2qi4hrkhlkp6wn2pfji" -}}
{{- with $fields := onepasswordItemFields "z54pr2l2qi4hrkhlkp6wn2pfji" -}}
{{- /* macOS: the LaunchAgent mounts the SMB share under ~/.local/mnt with
       ~/.local/bin/rustic-mount-backups (headless mount_smbfs; see that script
       for why not osascript). Linux: fstab mounts it at /backup on boot, so the
       hook only asserts it's there. */ -}}
{{- $darwin := eq $root.chezmoi.os "darwin" -}}
{{- $mount := printf "%s/.local/mnt/%s" $root.chezmoi.homeDir $fields.volume.value -}}
{{- $mountHook := printf "%s/.local/bin/rustic-mount-backups" $root.chezmoi.homeDir -}}
{{- if not $darwin -}}
{{- $mount = "/backup" -}}
{{- end -}}
{{- $checkin := printf "https://status.sierrasoftworks.com/api/v1/cron/backup.%s/check-in?token=%s&status=" $root.chezmoi.hostname $fields.cron_token.value -}}
[global]
opentelemetry = "{{ $fields.telemetry.value }}/v1/metrics"

# Check-ins are best effort: a slow or down monitor must neither block nor fail
# the backup. rustic runs hooks without a shell, hence the table form.
[global.hooks]
run-before = [
  { command = "curl", args = ["-sS", "-f", "-m", "15", "-o", "/dev/null", "{{ $checkin }}running"], on-failure = "warn" },
{{- if $darwin }}
  { command = {{ $mountHook | toJson }}, args = ["mount"] }
{{- else }}
  { command = "mountpoint", args = ["-q", {{ $mount | toJson }}] }
{{- end }}
]
run-after = [
{{- if $darwin }}
  { command = {{ $mountHook | toJson }}, args = ["unmount"], on-failure = "warn" },
{{- end }}
  { command = "curl", args = ["-sS", "-f", "-m", "15", "-o", "/dev/null", "{{ $checkin }}succeeded"], on-failure = "warn" }
]
run-failed = [
{{- if $darwin }}
  { command = {{ $mountHook | toJson }}, args = ["unmount"], on-failure = "warn" },
{{- end }}
  { command = "curl", args = ["-sS", "-f", "-m", "15", "-o", "/dev/null", "{{ $checkin }}failed"], on-failure = "warn" }
]

[repository]
repository = '{{ $mount }}/'
password = '{{- $fields.encryption.value -}}'

[snapshot-filter]
filter-hosts = ["{{ $root.chezmoi.hostname }}", "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"]

[backup]
exclude-if-present = [".nobackup", "CACHEDIR.TAG"]
host = "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"
git-ignore = true
metrics-job = "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"
{{- if $darwin }}
# The repository is mounted inside $HOME; never back it up into itself.
globs = ["!{{ $root.chezmoi.homeDir }}/.local/mnt"]
{{- end }}

[backup.metrics-labels]
"service.name" = "rustic"
"host.name" = "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"

[[backup.snapshots]]
sources = ['{{ $root.chezmoi.homeDir }}/']

[forget]
filter-hosts = ["{{ $root.chezmoi.hostname }}", "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"]
keep-tags = []
keep-within-daily = "7 days"
keep-monthly = 5
keep-yearly = 2
{{- end -}}
{{- end -}}
{{- end -}}
