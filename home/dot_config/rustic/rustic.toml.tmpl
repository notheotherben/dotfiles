{{- with $root := . }}
{{- with $details := onepasswordDetailsFields "z54pr2l2qi4hrkhlkp6wn2pfji" -}}
{{- with $fields := onepasswordItemFields "z54pr2l2qi4hrkhlkp6wn2pfji" -}}
{{- /* macOS mounts the SMB share under /Volumes via osascript; on Linux fstab
       mounts it at /backup on boot, so the hook only asserts it's there. */ -}}
{{- $mount := printf "/Volumes/%s" $fields.volume.value -}}
{{- $mountCmd := printf "osascript -e 'mount volume \"smb://%s@%s/%s\"'" $details.username.value $fields.server.value $fields.volume.value -}}
{{- if ne $root.chezmoi.os "darwin" -}}
{{- $mount = "/backup" -}}
{{- $mountCmd = printf "mountpoint -q %s" $mount -}}
{{- end -}}
[global]
opentelemetry = "{{ $fields.telemetry.value }}/v1/metrics"

[global.hooks]
run-before = [
  "curl https://status.sierrasoftworks.com/api/v1/cron/backup.{{ $root.chezmoi.hostname }}/check-in?status=running&token={{ $fields.cron_token.value }}",
  {{ $mountCmd | toJson }}
]
run-after = [
  "curl https://status.sierrasoftworks.com/api/v1/cron/backup.{{ $root.chezmoi.hostname }}/check-in?status=succeeded&token={{ $fields.cron_token.value }}"
]
run-failed = [
  "curl https://status.sierrasoftworks.com/api/v1/cron/backup.{{ $root.chezmoi.hostname }}/check-in?status=failed&token={{ $fields.cron_token.value }}"
]

[repository]
repository = '{{ $mount }}/'
password = '{{- $fields.encryption.value -}}'

[snapshot-filter]
filter-hosts = ["{{ $root.chezmoi.hostname }}", "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"]

[backup]
exclude-if-present = [".nobackup", "CACHEDIR.TAG"]
host = "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"
git-ignore = true
metrics-job = "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"

[backup.metrics-labels]
"service.name" = "rustic"
"host.name" = "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"

[[backup.snapshots]]
sources = ['{{ $root.chezmoi.homeDir }}/']

[forget]
filter-hosts = ["{{ $root.chezmoi.hostname }}", "{{ $root.chezmoi.hostname }}.{{ $fields.domain.value -}}"]
keep-tags = []
keep-within-daily = "7 days"
keep-monthly = 5
keep-yearly = 2
{{- end -}}
{{- end -}}
{{- end -}}