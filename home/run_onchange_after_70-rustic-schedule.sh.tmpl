#!/bin/sh
# (Re)load the hourly rustic backup job whenever its definition changes.
# Ported from extras/rustic.nix.
{{ if eq .chezmoi.os "darwin" -}}
#
# plist hash: {{ include "Library/LaunchAgents/dev.pannell.rustic-backup.plist.tmpl" | sha256sum }}
set -eu

label="dev.pannell.rustic-backup"
plist="$HOME/Library/LaunchAgents/$label.plist"
domain="gui/$(id -u)"

mkdir -p "$HOME/Library/Logs"

echo "==> Reloading LaunchAgent $label"
launchctl bootout "$domain/$label" 2>/dev/null || true
launchctl bootstrap "$domain" "$plist"
{{ else -}}
#
# unit hash: {{ include "dot_config/systemd/user/rustic-backup.service" | sha256sum }}
# unit hash: {{ include "dot_config/systemd/user/rustic-backup.timer" | sha256sum }}
set -eu

echo "==> Reloading rustic-backup.timer"
systemctl --user daemon-reload
systemctl --user enable --now rustic-backup.timer

# Never enable lingering here: this account is on systemd-homed, so starting
# user@.service at boot makes PAM demand the security token PIN before any
# greeter exists. Plymouth grabs the console for that prompt and login wedges.
# The timer's Persistent=true catches up missed runs at next login instead.
loginctl disable-linger "$(id -un)" 2>/dev/null || true
{{ end -}}
