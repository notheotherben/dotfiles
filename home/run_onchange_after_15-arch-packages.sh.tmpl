#!/bin/sh
# Arch/CachyOS package manifest — the Linux counterpart to ~/.Brewfile.
# Anything available from pacman, the AUR, or Flathub is installed here.
# Re-runs whenever the lists below change.
{{ if eq .chezmoi.os "linux" -}}
set -eu

# Official repositories (incl. the CachyOS overlays).
pacman_packages="
  android-tools
  ansible
  atuin
  azure-cli
  base-devel
  caddy
  cargo-binstall
  chezmoi
  cmake
  cpio
  docker
  docker-buildx
  docker-compose
  dotnet-sdk-10.0
  firefox
  fish
  ghostty
  git
  jq
  meson
  mise
  nomad
  pam-u2f
  protobuf
  rust
  rust-wasm
  rustic
  shellcheck
  signal-desktop
  speedtest-cli
  starship
  tailscale
  terraform
  uv
  vault
  vim
  xh
  zed
  zsh-syntax-highlighting
"

# AUR — no official repository package exists for these.
# 1password ships op-ssh-sign (git signing); 1password-cli ships `op`.
aur_packages="
  1password
  1password-cli
  claude-code
  nomad-pack
  powershell-bin
  signal-desktop-beta-bin
  synology-drive
  visual-studio-code-bin
"

# Flathub — desktop apps with no maintained native package.
flatpak_packages="
  com.fastmail.Fastmail
  com.rtosta.zapzap
  com.spotify.Client
  com.todoist.Todoist
  org.telegram.desktop
"

# macOS-only, deliberately not replaced here:
#   little-snitch  -> no equivalent (opensnitch in the AUR is the closest)
#   orbstack       -> Docker runs natively (docker/docker-compose above)
#   grpcurl        -> the AUR build fails; install it by hand if needed
# git-tool/shig/tailservice have no distro package at all and come from mise —
# see dot_config/mise/conf.d/linux.toml.

echo "==> pacman"
# shellcheck disable=SC2086
sudo pacman -Syu --needed --noconfirm $pacman_packages

aur_helper=""
for candidate in paru yay; do
  if command -v "$candidate" >/dev/null 2>&1; then
    aur_helper="$candidate"
    break
  fi
done

if [ -z "$aur_helper" ]; then
  # CachyOS ships paru, but a plain Arch install won't.
  echo "==> Installing paru"
  build="$(mktemp -d)"
  git clone --depth 1 https://aur.archlinux.org/paru-bin.git "$build/paru-bin"
  (cd "$build/paru-bin" && makepkg -si --noconfirm)
  rm -rf "$build"
  aur_helper="paru"
fi

echo "==> $aur_helper (AUR)"
# shellcheck disable=SC2086
"$aur_helper" -S --needed --noconfirm $aur_packages

if command -v flatpak >/dev/null 2>&1; then
  echo "==> flatpak"
  sudo flatpak remote-add --if-not-exists --system \
    flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  # shellcheck disable=SC2086
  sudo flatpak install --system --noninteractive --or-update flathub $flatpak_packages
else
  echo "!! flatpak not installed — skipping:$flatpak_packages"
fi
{{ else -}}
exit 0
{{ end -}}
